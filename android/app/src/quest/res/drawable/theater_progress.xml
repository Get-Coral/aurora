<?xml version="1.0" encoding="utf-8"?>
<!-- A thin track like .player-progress-track: 25% white, accent gradient played. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle">
            <size android:height="6dp" />
            <solid android:color="#40FFFFFF" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <size android:height="6dp" />
                <gradient android:endColor="@color/theater_accent_strong" android:startColor="@color/theater_accent" />
                <corners android:radius="3dp" />
            </shape>
        </scale>
    </item>
</layer-list>
