<?xml version="1.0" encoding="utf-8"?>
<!-- An environment card: a soft edge, the accent when chosen or aimed at. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theater_glass_soft" />
            <stroke android:width="3dp" android:color="@color/theater_accent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theater_glass_hover" />
            <stroke android:width="2dp" android:color="@color/theater_line" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/theater_glass_soft" />
            <stroke android:width="1.5dp" android:color="#1FAAC4FF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
