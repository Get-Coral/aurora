<?xml version="1.0" encoding="utf-8"?>
<!-- The environment picker: a grid of cards, one per environment, opened from
     the control bar. 1000x520dp on a 1.25x0.65m panel just above it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/theater_environments_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/theater_glass_bg"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/TheaterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theater_environments_title"
            android:textSize="24sp" />

        <GridLayout
            android:id="@+id/theater_environment_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:columnCount="4"
            android:useDefaultMargins="false" />
    </LinearLayout>
</FrameLayout>
