<?xml version="1.0" encoding="utf-8"?>
<!--
  The controls of the native TV player, laid out like the web player's TV mode
  (.player-controls-overlay in src/styles.css): title at the top, progress and
  one row of buttons at the bottom, over two dark gradients.
  The exo_* ids are the ones Media3's PlayerControlView wires up itself.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/aurora_player_scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_gravity="bottom"
        android:background="@drawable/aurora_player_scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="44dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aurora_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aurora_manrope_bold"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                android:textColor="@color/aurora_accent_strong"
                android:textSize="11sp"
                tools:text="Now playing" />

            <TextView
                android:id="@+id/aurora_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/aurora_space_grotesk_bold"
                android:maxLines="2"
                android:textColor="@color/aurora_ink"
                android:textSize="28sp"
                tools:text="The Rings of Power" />

            <TextView
                android:id="@+id/aurora_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/aurora_manrope_medium"
                android:textColor="@color/aurora_ink_faint"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="The Lord of the Rings · E1" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/aurora_close"
            style="@style/AuroraPlayerIconButton"
            android:src="@drawable/aurora_ic_x" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingBottom="22dp">

        <dev.getcoral.aurora.AuroraTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/AuroraPlayerIconButton"
                android:src="@drawable/aurora_ic_pause" />

            <LinearLayout
                android:id="@+id/aurora_skip_back"
                style="@style/AuroraPlayerSkipButton">

                <ImageView
                    style="@style/AuroraPlayerSkipIcon"
                    android:src="@drawable/aurora_ic_rotate_ccw" />

                <TextView
                    android:id="@+id/aurora_skip_back_label"
                    style="@style/AuroraPlayerSkipLabel"
                    tools:text="−15s" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/aurora_skip_forward"
                style="@style/AuroraPlayerSkipButton">

                <ImageView
                    style="@style/AuroraPlayerSkipIcon"
                    android:src="@drawable/aurora_ic_rotate_cw" />

                <TextView
                    android:id="@+id/aurora_skip_forward_label"
                    style="@style/AuroraPlayerSkipLabel"
                    tools:text="+30s" />
            </LinearLayout>

            <TextView
                android:id="@+id/aurora_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/aurora_manrope_medium"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/aurora_ink_muted"
                android:textSize="15sp"
                tools:text="0:57 / 1:13:34" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/aurora_audio"
                style="@style/AuroraPlayerIconButton"
                android:layout_marginEnd="6dp"
                android:src="@drawable/aurora_ic_languages"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/aurora_subtitles"
                style="@style/AuroraPlayerIconButton"
                android:src="@drawable/aurora_ic_captions"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
